<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- التطبيق بدون App Sandbox عمدًا:
         التحكم بالموسيقى عبر Apple Events، وقراءة الشبكة/الصوت عبر IOKit/CoreAudio
         تكون أبسط وأكثر استقرارًا بدون قيود الـ sandbox على MacBook 2015 -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
